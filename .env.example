# Required for creating/deactivating team member accounts (app/actions/users.ts).
# Get it from the Supabase dashboard: Project Settings -> API -> service_role key.
# Server-only secret: never expose it to the browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# n8n webhook that reports minutes used per Retell agent (lib/n8n.ts, getMinutesUsed).
# Production URL: https://rrb89.app.n8n.cloud/webhook/minutes-used
N8N_MINUTES_WEBHOOK_URL=
N8N_MINUTES_WEBHOOK_SECRET=

# n8n webhook that provisions a client's row in clientes_config (dashboard
# token + PIN access) when an agent_id is linked (lib/n8n.ts,
# provisionDashboardClient, called from setClientAgentId).
# Production URL: https://rrb89.app.n8n.cloud/webhook/provision-dashboard
# Secret is the same value as N8N_MINUTES_WEBHOOK_SECRET above (both webhooks
# reuse the same n8n "Header Auth account" credential).
N8N_PROVISION_DASHBOARD_WEBHOOK_URL=
N8N_PROVISION_DASHBOARD_WEBHOOK_SECRET=
